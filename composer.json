{
	"name": "yogaetvie/site",
	"description": "Yoga et Vie Albertville — thème et extension WordPress sur mesure (outillage de développement uniquement).",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint:php": "find wordpress tools -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n1 php -l",
		"lint:phpcs": "phpcs",
		"fix:phpcs": "phpcbf",
		"validate:theme": "php tools/validate-theme.php"
	}
}
